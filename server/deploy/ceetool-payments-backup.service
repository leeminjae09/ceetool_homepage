[Unit]
Description=CEETOOL daily consistent payment database snapshot
After=ceetool-payments.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/env PAYMENT_DB_PATH=/home/ubuntu/ceetool-payments/data/payments.sqlite /home/ubuntu/ceetool-payments/current/runtime/node /home/ubuntu/ceetool-payments/current/server/src/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/ceetool-payments/data
