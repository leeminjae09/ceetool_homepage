[Unit]
Description=CEETOOL daily consistent payment database snapshot
After=ceetool-payments.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/home/ubuntu/ceetool-payments/.env
ExecStart=/home/ubuntu/ceetool-payments/current/runtime/node /home/ubuntu/ceetool-payments/current/server/src/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/ceetool-payments/data
