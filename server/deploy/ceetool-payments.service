[Unit]
Description=CEETOOL payment API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ceetool-payments/current/server
EnvironmentFile=/home/ubuntu/ceetool-payments/.env
ExecStart=/usr/bin/env NODE_ENV=production PORT=3888 PAYMENT_DB_PATH=/home/ubuntu/ceetool-payments/data/payments.sqlite /home/ubuntu/ceetool-payments/current/runtime/node /home/ubuntu/ceetool-payments/current/server/src/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/ceetool-payments/data

[Install]
WantedBy=multi-user.target
