PAYSM_MID=
PAYSM_MERCHANT_KEY=

# Google OAuth web client; register this exact redirect URI:
# https://ceetool.com/api/payments/admin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google account email allowlist. No account is allowed when empty.
ADMIN_GOOGLE_EMAILS=

# Optional runtime settings; neither service URL is configurable.
NODE_ENV=development
PORT=3001
